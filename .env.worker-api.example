# DDCRM Worker API runtime configuration
# Service-auth tokens must be provided via secure secret storage in real environments.
# Do not reuse worker tokens in internal service-auth configuration.

WORKER_API_SERVICE_AUTH_ENABLED=true
WORKER_API_SERVICE_AUTH_ACCEPTED_TOKENS=replace-with-token-a,replace-with-token-b
WORKER_API_SERVICE_AUTH_CLIENT_TOKEN=replace-with-token-a

# Worker proxy credentials at-rest encryption key (used in worker state storage)
WORKER_PROXY_CREDENTIALS_ENCRYPTION_KEY=replace-with-worker-proxy-secrets-key

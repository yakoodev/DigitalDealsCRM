# DDCRM Worker API runtime configuration
# Service-auth tokens must be provided via secure secret storage in real environments.
# Do not reuse worker tokens in internal service-auth configuration.

WORKER_API_SERVICE_AUTH_ENABLED=true
WORKER_API_SERVICE_AUTH_ACCEPTED_TOKENS=replace-with-token-a,replace-with-token-b
WORKER_API_SERVICE_AUTH_CLIENT_TOKEN=replace-with-token-a

# Worker proxy credentials at-rest encryption key (used in worker state storage)
WORKER_PROXY_CREDENTIALS_ENCRYPTION_KEY=replace-with-worker-proxy-secrets-key

# Worker marketplace auth credentials at-rest encryption key (used in worker state storage)
WORKER_MARKETPLACE_AUTH_ENCRYPTION_KEY=replace-with-worker-marketplace-auth-key

# Account binding variables are injected by Accounts Manager autospawn per worker instance.
# Keep them empty in static env templates.
DDCRM_WORKER_ACCOUNT_ID=
FUNPAY_WORKER_ACCOUNT_ID=
PLAYEROK_WORKER_ACCOUNT_ID=

# Runtime template placeholders for integration-worker account-types:
# {accountId}, {accountIdN}, {projectId} -> expanded by Accounts Manager on spawn.
# Example for isolated storage namespace:
# STEAM_ACCOUNTS_STORAGE_NAMESPACE=steam-{projectId}-{accountIdN}

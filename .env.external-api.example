# DDCRM External API runtime configuration
# CORS values are environment-specific and must be set per deployment.

EXTERNAL_API_CORS_ENABLED=true
EXTERNAL_API_CORS_ALLOW_CREDENTIALS=true
EXTERNAL_API_CORS_ALLOW_ORIGINS=https://app.ddcrm.local
EXTERNAL_API_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
EXTERNAL_API_CORS_ALLOW_HEADERS=Authorization,Content-Type,Idempotency-Key,X-Request-Id
EXTERNAL_API_CORS_EXPOSE_HEADERS=X-Request-Id
EXTERNAL_API_CORS_MAX_AGE_SECONDS=600

# External API JWT validation (local/ci defaults)
EXTERNAL_API_JWT_ISSUER=ddcrm-local
EXTERNAL_API_JWT_AUDIENCE=ddcrm-api
EXTERNAL_API_JWT_SIGNING_KEY=replace-with-long-random-signing-key

# System admin claim gate for /v1/admin/* endpoints
EXTERNAL_API_SYSTEM_PERMISSION_CLAIM_TYPE=ddcrm.system.permissions
EXTERNAL_API_SYSTEM_PERMISSION_CLAIM_VALUE=system.accountManager.manage
EXTERNAL_API_SYSTEM_INTEGRATIONS_PERMISSION_CLAIM_VALUE=system.integrations.manage

# Offer/Workflow/Custom HTTP feature rollout flags
FEATURE_OFFERS_ENABLED=true
FEATURE_WORKFLOWS_ENABLED=true
FEATURE_CUSTOM_HTTP_INTEGRATIONS_ENABLED=true

# Incoming purchase webhook secret for workflow trigger (/v1/integrations/workflow/purchase)
WORKFLOW_PURCHASE_WEBHOOK_SECRET=replace-with-workflow-purchase-webhook-secret

# Worker message -> workflow polling bridge (message-trigger path for marketplace conversations)
RouteRegistryClient__BaseUrl=http://localhost:15110
WorkflowMessagePolling__Enabled=true
WorkflowMessagePolling__RouteRegistryBaseUrl=http://localhost:15110
WorkflowMessagePolling__WorkerBaseUrlTemplate=http://localhost:15072
WorkflowMessagePolling__WorkerPathPrefix=/internal/v2/worker
WorkflowMessagePolling__OnlyUnreadConversations=true
WorkflowMessagePolling__MaxMessagesPerConversationPerPoll=1
WorkflowMessagePolling__SkipFirstMessagePerConversation=true
# Safety switch: disable real marketplace replies while testing workflow execution.
WorkflowMessagePolling__DispatchWorkerReplies=true

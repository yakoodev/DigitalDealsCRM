# DDCRM Test Worker (simulator) runtime configuration
# Non-production only: local/ci/staging.
# Do not enable this profile in production.

TEST_WORKER_ENABLED=false
TEST_WORKER_DEFAULT_VISIBILITY=hidden
TEST_WORKER_ALLOWED_ENVIRONMENTS=local,ci,staging
TEST_WORKER_BLOCK_IN_PRODUCTION=true

# Scenario + fixture controls
TEST_WORKER_SCENARIO=TW-SCN-HAPPY-PATH
TEST_WORKER_CAPABILITY_PROFILE=TW-CAP-CORE-V1
TEST_WORKER_PROVIDER=platimarket
TEST_WORKER_FIXTURE_SOURCE=./fixtures/test-worker
TEST_WORKER_FIXTURE_REVISION=main

# Extension controls (`ext.test.*`)
TEST_WORKER_EXT_ACTIONS_ENABLED=true

# DDCRM Internal API runtime configuration
# Service-auth tokens must be provided via secure secret storage in real environments.
# Do not reuse internal tokens in worker service-auth configuration.

INTERNAL_API_SERVICE_AUTH_ENABLED=true
INTERNAL_API_SERVICE_AUTH_ACCEPTED_TOKENS=replace-with-internal-token-a,replace-with-internal-token-b
INTERNAL_API_SERVICE_AUTH_CLIENT_TOKEN=replace-with-internal-token-a

# Worker control client (for internal services that call Worker API directly, e.g. Accounts Manager)
# Worker client token must not match INTERNAL_API_SERVICE_AUTH_CLIENT_TOKEN.
WORKER_CONTROL_CLIENT_ENABLED=true
WORKER_CONTROL_CLIENT_BASE_URL_TEMPLATE=http://localhost:5072
WORKER_CONTROL_CLIENT_PATH_PREFIX=/internal/v2/worker
WORKER_API_SERVICE_AUTH_CLIENT_TOKEN=replace-with-worker-token-a

# AccountManager Docker autospawn
ACCOUNT_MANAGER_AUTOSPAWN_ENABLED=false
ACCOUNT_MANAGER_AUTOSPAWN_DOCKER_ENDPOINT=unix:///var/run/docker.sock
ACCOUNT_MANAGER_AUTOSPAWN_DOCKER_NETWORK=ddcrm_ddcrm
ACCOUNT_MANAGER_AUTOSPAWN_WORKER_INTERNAL_PORT=8080
ACCOUNT_MANAGER_AUTOSPAWN_HEALTH_TIMEOUT_SECONDS=45
ACCOUNT_MANAGER_AUTOSPAWN_HEALTH_POLL_INTERVAL_MS=800
ACCOUNT_MANAGER_AUTOSPAWN_FALLBACK_WORKER_ID=worker-api
ACCOUNT_MANAGER_AUTOSPAWN_REGISTRY_SECRET_ENCRYPTION_KEY=replace-with-long-random-registry-key

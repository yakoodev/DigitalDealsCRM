# DDCRM Internal API runtime configuration
# Service-auth tokens must be provided via secure secret storage in real environments.

INTERNAL_API_SERVICE_AUTH_ENABLED=true
INTERNAL_API_SERVICE_AUTH_ACCEPTED_TOKENS=replace-with-internal-token-a,replace-with-internal-token-b
INTERNAL_API_SERVICE_AUTH_CLIENT_TOKEN=replace-with-internal-token-a
